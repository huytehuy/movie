rules_version = '2';

// Rules cho Firestore: dán nội dung này vào Firebase Console
// (Firestore Database -> Rules -> Publish).
service cloud.firestore {
  match /databases/{database}/documents {

    // Ai được xem log (trang /admin).
    //
    // UID lấy từ Firebase Console -> Authentication -> Users, cột "User UID".
    // Khớp theo UID chắc ăn hơn email (không sợ sai hoa/thường hay đổi email);
    // dòng email để dự phòng, trúng cái nào cũng được.
    //
    // Thêm người xem log: thêm một dòng `request.auth.uid == '<uid>' ||`.
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == 'o4iuTxaTuJQOzMHJwRPjFsY2gLJ3' ||
        request.auth.token.email == 'admin@huytehuy.id.vn'
      );
    }

    // Log xem phim: máy nào, lúc nào, phim gì, tập mấy.
    match /watch-logs/{logId} {
      // Người xem không đăng nhập nhưng vẫn ghi được log — chỉ ghi thêm,
      // không sửa, không xoá, không đọc của người khác.
      allow create: if request.resource.data.keys().hasAll(
                        ['deviceId', 'filmId', 'episodeName', 'timestamp'])
                    && request.resource.data.deviceId is string
                    && request.resource.data.deviceId.size() <= 64
                    && request.resource.data.filmName.size() <= 200
                    && request.resource.data.timestamp == request.time;
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Lịch sử cũ theo tài khoản Google — không còn ghi mới, khoá luôn.
    match /watch-history/{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
