<?xml version="1.0" encoding="utf-8"?>
<!-- 320x180 banner shown on the Android TV home screen. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#FF16121C"
                android:centerColor="#FF2B1420"
                android:endColor="#FF4A1524"
                android:type="linear"/>
        </shape>
    </item>
    <item
        android:gravity="center"
        android:width="96dp"
        android:height="96dp">
        <bitmap android:src="@mipmap/launcher_icon" android:gravity="center"/>
    </item>
</layer-list>
